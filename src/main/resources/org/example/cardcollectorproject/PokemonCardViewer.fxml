<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.cardcollectorproject.controllers.PokemonCardViewerController">

    <top>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <ComboBox fx:id="searchCriteriaBox" prefWidth="150"/>
            <TextField fx:id="searchField" promptText="Enter search..."/>
            <Button fx:id="searchButton" text="Search"/>
            <ComboBox fx:id="sortOptions" prefWidth="150"/>
        </HBox>
    </top>

    <left>
        <ListView fx:id="listView" prefWidth="300"/>
    </left>

    <center>
        <VBox fx:id="cardDetailBox" spacing="10" visible="false" managed="false">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button text="Close" fx:id="closeButton"/>
            <ImageView fx:id="cardImageView" fitWidth="200"/>
            <Label fx:id="nameLabel"/>
            <Label fx:id="setLabel" text="Set: "/>
            <Label fx:id="priceLabel" text="Price: "/>
            <Label fx:id="typeLabel"/>
            <Label fx:id="mechanicLabel"/>
            <Label fx:id="movesLabel"/>
            <Label fx:id="cardNumberLabel"/>

            <!-- New: Description Label -->
            <Label fx:id="descriptionLabel" wrapText="true" maxWidth="300"/>
        </VBox>
    </center>

</BorderPane>





