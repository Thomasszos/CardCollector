<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.cardcollectorproject.controllers.SettingsDialogController"
      spacing="15" styleClass="settings-dialog" prefWidth="400" prefHeight="300"
      stylesheets="@styles/settings_dialog.css">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Settings" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Separator/>

    <!-- Audio Settings Section -->
    <TitledPane text="Audio Settings" expanded="true">
        <VBox spacing="15">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Background Music:" minWidth="120"/>
                <ToggleButton fx:id="toggleMusicButton" selected="true" text="On"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Volume:" minWidth="120"/>
                <Slider fx:id="volumeSlider" min="0" max="1" value="0.5" prefWidth="150" showTickMarks="true"/>
                <Label fx:id="volumeLabel" text="50%"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Sound Effects:" minWidth="120"/>
                <ToggleButton fx:id="toggleSoundEffectsButton" selected="true" text="On"/>
            </HBox>
        </VBox>
    </TitledPane>

    <!-- The About section with Easter Egg will be added programmatically -->

    <Region VBox.vgrow="ALWAYS"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="saveButton" text="Save" defaultButton="true"/>
        <Button fx:id="cancelButton" text="Cancel" cancelButton="true"/>
    </HBox>
</VBox>