<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.cardcollectorproject.controllers.CollectionController"
      spacing="10"
      styleClass="collection-container">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Title with user name -->
    <Label fx:id="userLabel" text="Card Collection" styleClass="collection-title"/>

    <!-- Empty collection message -->
    <Label fx:id="emptyCollectionLabel" text="Your collection is empty. Add cards from the search tab!"
           visible="false" styleClass="empty-collection-message"/>

    <!-- Card grid -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <TilePane fx:id="collectionTilePane"
                  hgap="10" vgap="10"
                  prefColumns="4"
                  styleClass="card-grid"/>
    </ScrollPane>
</VBox>