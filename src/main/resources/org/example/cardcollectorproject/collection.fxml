<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/22"
            fx:controller="org.example.cardcollectorproject.controllers.CollectionController"
            stylesheets="@styles/collection.css">
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
            <content>
                <VBox styleClass="overlay" spacing="20">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <!-- Collection Content -->
                    <VBox styleClass="inner-container" VBox.vgrow="ALWAYS">
                        <!-- Simplified Header with title -->
                        <HBox alignment="CENTER" spacing="15" styleClass="header-container">
                            <Label fx:id="userLabel" text="Card Collection" styleClass="collection-title"/>
                            <Region HBox.hgrow="ALWAYS"/> <!-- Spacer -->
                            <Button fx:id="statsButton" text="Stats" styleClass="stats-button">
                                <graphic>
                                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                                        <image>
                                            <Image url="@images/stats_icon.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                                <tooltip><Tooltip text="View collection statistics"/></tooltip>
                            </Button>
                        </HBox>

                        <!-- Search and filter controls -->
                        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="search-container">
                            <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="search-box">
                                <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                                    <image>
                                        <Image url="@images/search_icon.png"/>
                                    </image>
                                </ImageView>
                                <TextField fx:id="searchField" promptText="Search your collection..."
                                           styleClass="search-field" HBox.hgrow="ALWAYS"/>
                                <Button fx:id="clearSearchButton" text="✕" styleClass="clear-search-button"/>
                            </HBox>

                            <ComboBox fx:id="filterTypeBox" promptText="Filter by type" styleClass="filter-box">
                                <tooltip><Tooltip text="Filter by Pokémon type"/></tooltip>
                            </ComboBox>

                            <ComboBox fx:id="sortBox" promptText="Sort by" styleClass="sort-box">
                                <tooltip><Tooltip text="Sort your collection"/></tooltip>
                            </ComboBox>
                        </HBox>

                        <!-- Compact Collection stats panel -->
                        <HBox spacing="15" alignment="CENTER" styleClass="stats-container">
                            <HBox spacing="10" alignment="CENTER" styleClass="stat-box">
                                <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                                    <image>
                                        <Image url="@images/cards_icon.png"/>
                                    </image>
                                </ImageView>
                                <Label fx:id="cardCountLabel" text="Cards: 0" styleClass="stats-label"/>
                            </HBox>

                            <HBox spacing="10" alignment="CENTER" styleClass="stat-box">
                                <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                                    <image>
                                        <Image url="@images/value_icon.png"/>
                                    </image>
                                </ImageView>
                                <Label fx:id="totalPriceLabel" text="Total Value: $0.00" styleClass="total-price-label"/>
                            </HBox>

                            <HBox spacing="10" alignment="CENTER" styleClass="stat-box">
                                <Button fx:id="refreshButton" text="Refresh Prices" styleClass="refresh-button">
                                    <graphic>
                                        <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                                            <image>
                                                <Image url="@images/refresh_icon.png"/>
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                            </HBox>
                        </HBox>

                        <!-- Card collection area - Now only using TilePane for card display -->
                        <StackPane VBox.vgrow="ALWAYS" styleClass="collection-container">
                            <ScrollPane fx:id="cardScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="card-scroll-pane">
                                <TilePane fx:id="collectionTilePane" styleClass="card-tile-pane"/>
                            </ScrollPane>

                            <!-- Empty state message -->
                            <VBox fx:id="emptyStateBox" alignment="CENTER" spacing="20" styleClass="empty-state-container">
                                <ImageView fitWidth="120" fitHeight="120" preserveRatio="true">
                                    <image>
                                        <Image url="@images/empty_collection.png"/>
                                    </image>
                                </ImageView>
                                <Label fx:id="emptyCollectionLabel"
                                       text="Your collection is empty. Start searching for cards to add!"
                                       styleClass="empty-collection-message"/>
                                <Button text="Search for Cards" styleClass="action-button-large"/>
                            </VBox>
                        </StackPane>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>