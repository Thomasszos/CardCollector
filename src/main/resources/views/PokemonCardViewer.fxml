<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.cardcollectorproject.controllers.PokemonCardViewerController"
      spacing="10">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <TextField fx:id="nameField" promptText="Enter Pokémon name"/>
    <TextField fx:id="typeField" promptText="Enter Pokémon type (e.g. Fire, Electric)"/>
    <Button fx:id="searchButton" text="Search"/>
    <ComboBox fx:id="sortOptions"/>
    <ListView fx:id="listView"/>

</VBox>



